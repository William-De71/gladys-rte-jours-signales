{
  "name": "gladys-rte-jours-signales",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for the days RTE flags on the French grid, through the official RTE APIs: PP days of the capacity mechanism (today, tomorrow, the day after, peak periods) and demand response days, scene triggers, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-rte-jours-signales",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-rte-jours-signales.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "rte",
    "jours-pp",
    "capacity-mechanism",
    "demand-response",
    "effacement",
    "home-automation"
  ]
}
