  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your RTE application",
        "fr": "Votre application RTE",
        "de": "Deine RTE-Anwendung",
        "es": "Su aplicación RTE"
      },
      "description": {
        "en": "The integration reads the official RTE APIs, free of charge. 1. Create an account on data.rte-france.com. 2. Open the “Signal” API (PP days) and the “Demand Response Signal” API, and click “Subscribe to API” on each, attaching both to the same new application (Web / Server). 3. In “My applications”, copy the client id and the client secret of that application here.",
        "fr": "L’intégration lit les API officielles de RTE, gratuites. 1. Créez un compte sur data.rte-france.com. 2. Ouvrez l’API « Signal » (jours PP) et l’API « Demand Response Signal », et cliquez sur « Abonnez-vous à l’API » sur chacune, en les rattachant toutes deux à une même nouvelle application (Web / Serveur). 3. Dans « Mes applications », copiez ici l’ID client et l’ID secret de cette application.",
        "de": "Die Integration liest die offiziellen, kostenlosen RTE-APIs. 1. Leg ein Konto auf data.rte-france.com an. 2. Öffne die API „Signal“ (PP-Tage) und die API „Demand Response Signal“ und klick bei beiden auf „Subscribe to API“, verknüpft mit derselben neuen Anwendung (Web / Server). 3. Kopier unter „My applications“ die Client-ID und das Client-Secret dieser Anwendung hierher.",
        "es": "La integración lee las API oficiales de RTE, gratuitas. 1. Cree una cuenta en data.rte-france.com. 2. Abra la API «Signal» (días PP) y la API «Demand Response Signal», y haga clic en «Subscribe to API» en cada una, vinculándolas a una misma aplicación nueva (Web / Server). 3. En «My applications», copie aquí el ID de cliente y el secreto de esa aplicación."
      },
      "links": [
        {
          "url": "https://data.rte-france.com/catalog/-/api/market/Signal/v2.0",
          "label": {
            "en": "“Signal” API (PP days)",
            "fr": "API « Signal » (jours PP)",
            "de": "API „Signal“ (PP-Tage)",
            "es": "API «Signal» (días PP)"
          }
        },
        {
          "url": "https://data.rte-france.com/catalog/-/api/market/Demand-Response-Signal/v2.0",
          "label": {
            "en": "“Demand Response Signal” API",
            "fr": "API « Demand Response Signal »",
            "de": "API „Demand Response Signal“",
            "es": "API «Demand Response Signal»"
          }
        }
      ]
    },
    {
      "key": "client_id",
      "type": "string",
